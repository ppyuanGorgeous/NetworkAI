# Generated secrets are written to .env by scripts/configure-local.py.
WEB_PORT=3000
ES_PASSWORD=replace-with-a-random-local-password
JWT_SECRET=replace-with-at-least-32-random-bytes

# Paid AI is intentionally disabled after deployment.
ENABLE_PAID_AI=false
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_AGENT_MODEL=gpt-4.1-mini
